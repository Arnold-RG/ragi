# RAGI backend — copy to .env and fill. Never commit .env.

NODE_ENV=development
RAGI_HOST=0.0.0.0
RAGI_PORT=8787
RAGI_PUBLIC_ORIGIN=http://127.0.0.1:8787
RAGI_WEB_ORIGIN=http://127.0.0.1:4173,http://localhost:4173,https://arnold-rg.github.io

# Target host class: 32GB+ RAM. Heap leaves headroom for OS/DB/Redis.
RAGI_HEAP_MB=28672
RAGI_CACHE_BUDGET_MB=4096
RAGI_WORKER_THREADS=8

# Database — SQLite for local; Postgres for production power
DATABASE_URL="file:./data/ragi.db"
# DATABASE_URL="postgresql://ragi:ragi@127.0.0.1:5432/ragi?schema=public"

# Optional Redis (sessions / hot cache). Leave empty to use in-process store.
REDIS_URL=

# Master secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
RAGI_MASTER_KEY=
RAGI_SESSION_SECRET=
RAGI_COOKIE_NAME=ragi_session

# Owner bootstrap (used only by seed script; not served to clients)
OWNER_PASSPHRASE="your-passphrase-quote-if-contains-#"
OWNER_BACKUP_CODE="123456"
OWNER_DEVICE_KEY="your-device-key"

OWNER_TOTP_ISSUER=RAGI

# Gemini (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8787/api/v1/calendar/google/callback

# Microsoft Graph / Outlook OAuth
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://127.0.0.1:8787/api/v1/calendar/microsoft/callback

# WebAuthn / passkeys
RP_ID=127.0.0.1
RP_NAME=RAGI
RP_ORIGIN=http://127.0.0.1:8787

# Security knobs
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=900
SESSION_TTL_SECONDS=28800
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
