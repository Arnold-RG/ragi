{
  "name": "ragi-backend",
  "version": "1.0.0",
  "private": true,
  "description": "RAGI owner-only private secretary API — high-memory secure backend",
  "type": "module",
  "engines": {
    "node": "^22.12 || >=24"
  },
  "scripts": {
    "dev": "node --import tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --max-old-space-size=${RAGI_HEAP_MB:-28672} dist/server.js",
    "start:win": "node --max-old-space-size=28672 dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev --name init",
    "db:push": "prisma db push",
    "seed": "tsx src/scripts/seed-owner.ts",
    "reseed": "tsx src/scripts/reseed.ts && tsx src/scripts/seed-owner.ts",
    "smoke:auth": "tsx src/scripts/smoke-auth.ts",
    "smoke:accounts": "tsx src/scripts/smoke-accounts.ts",
    "health": "tsx src/scripts/healthcheck.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.0.1",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.3",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^13.1.1",
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.6.0",
    "jose": "^6.0.10",
    "otplib": "^12.0.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "undici": "^7.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/qrcode": "^1.5.5",
    "prisma": "^7.10.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
