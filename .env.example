# RAGI v2 — example environment. Copy to backend/.env (git-ignored) and fill in.
# Never commit real values. Created by Arnold Rurangwa / Arnova Group.

# --- App ---
APP_NAME=RAGI
APP_ENV=development                 # development | test | staging | production
API_DOCS_ENABLED=true               # must be false outside development
CORS_ORIGINS='["http://localhost:3410","http://127.0.0.1:3410"]'

# --- Database (PostgreSQL; SQLite fallback is development-only) ---
DATABASE_URL=postgresql+psycopg://ragi:CHANGE_ME@127.0.0.1:55410/ragi_db
REDIS_URL=

# --- Sessions & MFA ---
SESSION_COOKIE_NAME=ragi_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=true
FIELD_ENCRYPTION_KEY=               # Fernet key; encrypts MFA secrets. Generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
MFA_REQUIRED_ROLES='["owner","admin"]'
MAX_MFA_FAILURES=5
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15

# --- Identity (spec gap #2: shared sign-in, owner decision) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- AI providers (agents are placeholders; provider is an owner decision) ---
OPENAI_API_KEY=
XAI_API_KEY=

# --- GitHub App (read-only monitoring) ---
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_FILE=
GITHUB_WEBHOOK_SECRET=

# --- Ecosystem ---
RAGI_API_URL=http://127.0.0.1:8410
OMH_API_URL=http://127.0.0.1:8420
ECOSYSTEM_KEYRING_FILE=/path/outside/repo/keyring.json   # per-service rotating HMAC keys (see ecosystem-contracts/docs/authentication.md)
ECOSYSTEM_SIGNING_KEY_ID=ragi-YYYY-MM
ECOSYSTEM_MAX_CLOCK_SKEW_SECONDS=300

# --- Files ---
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=

# --- Safety switches (all OFF until the owner decides) ---
AGENTS_ENABLED=false
REPOSITORY_WRITES_ENABLED=false
PRODUCTION_DEPLOYMENT_ENABLED=false

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_RAGI_WS_URL=
NEXT_PUBLIC_OMH_URL=http://localhost:3420
RAGI_API_ORIGIN=http://127.0.0.1:8410

# --- GitHub OAuth (sign-in only; separate from the GitHub App above) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (password reset codes via Resend) ---
RESEND_API_KEY=
MAIL_FROM=

# --- Registration ---
REGISTRATION_MODE=closed            # closed | invite | open
REGISTRATION_OPEN_CONFIRMED=false   # required in production when mode is open
